#!/bin/bash
#
# configure-with-progress: Wrapper attorno a configure che mostra una barra di progresso
# Uso: ./configure-with-progress [opzioni di configure]

set -e

# Colori e formattazione
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Variabili globali
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIGURE_SCRIPT="$SCRIPT_DIR/configure"
START_TIME=$(date +%s)
CURRENT_PHASE=""
TOTAL_PHASES=0
CURRENT_PHASE_NUM=0
LOG_FILE="/tmp/haiku_configure_$$.log"

# Fasi del configure (stimate)
declare -a PHASES=(
	"Validazione prerequisiti (Python, nasm, awk, wget, git)"
	"Impostazione variabili di ambiente"
	"Determinazione architetture target"
	"Compilazione cross-tools"
	"Configurazione del sistema di build"
	"Generazione BuildConfig e Jamfile"
	"Completato!"
)

TOTAL_PHASES=${#PHASES[@]}

# Funzione per mostrare la barra di progresso
show_progress() {
	local phase_num=$1
	local message=$2
	local percent=$((phase_num * 100 / TOTAL_PHASES))
	
	# Lunghezza della barra
	local bar_length=40
	local filled=$((percent * bar_length / 100))
	local empty=$((bar_length - filled))
	
	# Costruisci la barra
	local bar="["
	for ((i=0; i<filled; i++)); do
		bar+="█"
	done
	for ((i=0; i<empty; i++)); do
		bar+="░"
	done
	bar+="]"
	
	# Calcola tempo trascorso e ETA
	local current_time=$(date +%s)
	local elapsed=$((current_time - START_TIME))
	local eta=""
	
	if [ $phase_num -gt 1 ]; then
		local per_phase=$((elapsed / (phase_num - 1)))
		local remaining_phases=$((TOTAL_PHASES - phase_num))
		local eta_seconds=$((per_phase * remaining_phases))
		eta="ETA: $(format_time $eta_seconds)"
	fi
	
	# Stampa la riga di progresso
	printf "\r${BLUE}${bar}${NC} ${BOLD}${percent}%%${NC} - ${CYAN}${message}${NC} ${eta:+[$eta]}"
}

# Funzione per formattare il tempo
format_time() {
	local seconds=$1
	local hours=$((seconds / 3600))
	local minutes=$(((seconds % 3600) / 60))
	local secs=$((seconds % 60))
	
	if [ $hours -gt 0 ]; then
		printf "%dh %dm %ds" $hours $minutes $secs
	elif [ $minutes -gt 0 ]; then
		printf "%dm %ds" $minutes $secs
	else
		printf "%ds" $secs
	fi
}

# Funzione per mostrare lo stato
print_status() {
	local phase=$1
	local symbol=$2
	local color=$3
	
	echo -e "\n${color}${symbol} ${BOLD}${phase}${NC}"
}

# Funzione per monitorare il file di log
monitor_build() {
	local log_file=$1
	local arch_count=1
	
	# Estrai il numero totale di architetture da compilare
	local total_archs=$(echo "$@" | grep -o "\-\-build\-cross\-tools" | wc -l)
	if [ $total_archs -eq 0 ]; then
		total_archs=1
	fi
	
	while [ -e "$log_file" ]; do
		# Monitora il progresso della compilazione
		if grep -q "Configuring binutils" "$log_file" 2>/dev/null; then
			show_progress 3 "Building cross-tools (binutils)..."
		elif grep -q "Configuring gcc" "$log_file" 2>/dev/null; then
			show_progress 4 "Building cross-tools (gcc)..."
		elif grep -q "successfully built" "$log_file" 2>/dev/null; then
			show_progress 5 "Finalizing..."
		fi
		
		# Controlla se il processo è finito
		if ! pgrep -f "configure " > /dev/null 2>&1; then
			break
		fi
		
		sleep 1
	done
}

# Intestazione
echo -e "${BOLD}${BLUE}╔════════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║${NC}  Haiku Configure con Barra di Progresso"
echo -e "${BLUE}║${NC}  $(date '+%Y-%m-%d %H:%M:%S')"
echo -e "${BOLD}${BLUE}╚════════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Mostra i parametri
echo -e "${CYAN}Parametri:${NC} $@"
echo ""

# Mostra le fasi
echo -e "${YELLOW}Fasi di configurazione:${NC}"
for i in "${!PHASES[@]}"; do
	printf "  ${CYAN}%2d.${NC} %s\n" $((i+1)) "${PHASES[$i]}"
done
echo ""

# Avvia il configure in background
print_status "Avvio della configurazione..." "⏳" "$BLUE"
show_progress 1 "Validazione prerequisiti..."

# Redireziona l'output del configure al log file
"$CONFIGURE_SCRIPT" "$@" > "$LOG_FILE" 2>&1 &
configure_pid=$!

# Monitora il progresso
while kill -0 $configure_pid 2>/dev/null; do
	# Controlla le varie fasi leggendo il log
	if grep -q "python.*--version" "$LOG_FILE" 2>/dev/null; then
		show_progress 1 "Validazione prerequisiti..."
	fi
	
	if grep -q "HOST_PLATFORM" "$LOG_FILE" 2>/dev/null; then
		show_progress 2 "Impostazione variabili..."
	fi
	
	if grep -q "targetArchs\|determinating" "$LOG_FILE" 2>/dev/null; then
		show_progress 3 "Determinazione architetture..."
	fi
	
	if grep -q "build_cross_tools\|Configuring\|Making cross" "$LOG_FILE" 2>/dev/null; then
		# Estrai l'architettura che si sta compilando
		local current_arch=$(grep -oE "cross-tools-[a-z0-9_]+" "$LOG_FILE" | tail -1 | sed 's/cross-tools-//')
		show_progress 4 "Compilazione cross-tools${current_arch:+ ($current_arch)}..."
	fi
	
	if grep -q "BuildConfig\|Jamfile" "$LOG_FILE" 2>/dev/null; then
		show_progress 5 "Generazione file di build..."
	fi
	
	sleep 0.5
done

# Aspetta la terminazione
wait $configure_pid
exit_code=$?

echo "" # Newline dopo la barra

# Controlla il risultato
if [ $exit_code -eq 0 ]; then
	print_status "Configurazione completata con successo!" "✓" "$GREEN"
	show_progress 6 "Completato!"
	echo "" # Newline finale
	
	# Mostra statistiche
	total_time=$(($(date +%s) - START_TIME))
	echo -e "${GREEN}Tempo totale: $(format_time $total_time)${NC}"
	echo ""
	
	# Estrai informazioni utili dal log
	if grep -q "Configured successfully!" "$LOG_FILE"; then
		echo -e "${CYAN}Prossimo passo:${NC}"
		echo -e "  ${BOLD}cd generated.x86_64 && jam -q${NC}"
	fi
	
	rm -f "$LOG_FILE"
	exit 0
else
	print_status "Configurazione fallita!" "✗" "$RED"
	echo "" # Newline dopo il messaggio
	echo -e "${RED}Errore (exit code: $exit_code)${NC}"
	echo ""
	echo -e "${YELLOW}Ultimi 30 righe del log:${NC}"
	tail -30 "$LOG_FILE"
	echo ""
	echo -e "${YELLOW}Log completo in: $LOG_FILE${NC}"
	exit $exit_code
fi
