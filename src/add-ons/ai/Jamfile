SubDir HAIKU_TOP src add-ons ai ;

# Use network private headers for URL/HTTP handling
UsePrivateHeaders network netservices shared ;
# 1. Impostiamo gli header per tutta la cartella dei plugin
UsePublicHeaders ai support ;
UseHeaders [ FDirName $(HAIKU_TOP) src kits ai ] : true ;

# Se i sorgenti di microgpt-c hanno bisogno dei propri header interni
UseHeaders [ FDirName $(HAIKU_TOP) src third_party microgpt-c src ] : true ;

# Flag globali di compilazione (microgpt feature)
SubDirC++Flags -DHAVE_MICROGPT=1 ;

# ----------------------------------------------------
# REGOLA CUSTOM PER GLI ATTRIBUTI BFS
# ----------------------------------------------------
# Questa regola dice a Jam di agganciare il comando addattr al target compilato
rule AddPluginTypeAttribute Target : Type
{
    # Diciamo a Jam che l'azione dipende dalla creazione del Target
    AddPluginTypeAttributeAction $(Target) ;
    # Passiamo il tipo come variabile legata a quel preciso Target
    PLUGIN_TYPE on $(Target) = $(Type) ;
}

actions AddPluginTypeAttributeAction
{
    addattr -t string "AI:plugin_type" "$(PLUGIN_TYPE)" "$(1)"
}

# ----------------------------------------------------
# PLUGIN STANDARD (network + BE)
# ----------------------------------------------------

Addon OpenAIPlugin : openai_plugin.cpp : be libai_api.so libbnetapi.so libnetservices.a [ TargetLibstdc++ ]
            [ TargetLibsupc++ ] <$(TARGET_PACKAGING_ARCH)>libshared.a $(TARGET_NETWORK_LIBS) ;
AddPluginTypeAttribute OpenAIPlugin : remote ;

Addon PublicAIPlugin : publicai_plugin.cpp : be libai_api.so libbnetapi.so libnetservices.a [ TargetLibstdc++ ]
            [ TargetLibsupc++ ] <$(TARGET_PACKAGING_ARCH)>libshared.a $(TARGET_NETWORK_LIBS) ;
AddPluginTypeAttribute PublicAIPlugin : remote ;

