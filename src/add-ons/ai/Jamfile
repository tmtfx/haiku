# ----------------------------------------------------
# PLUGIN MICROGPT (Con sorgenti bundled incorporati)
# ----------------------------------------------------

# Definiamo la lista dei sorgenti di microgpt estratti in modo pulito
local microgptSources =
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_organelle.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_msa.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_vm.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_vm_natives.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_vm_parser.l.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_vm_parser.tab.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_oql.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_oql_parser.l.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_oql_parser.tab.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_eml.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_vr.c ]
    [ FDirName $(HAIKU_TOP) src third_party microgpt-c src microgpt_turboquant.c ]
;

Addon MicrogptPlugin : 
    microgpt_plugin.cpp 
    $(microgptSources) 
    : 
    be ai_api stdc++ 
;
# Essendo un LLM integrato/embedded che gira localmente sulla CPU:
AddPluginTypeAttribute MicrogptPlugin : local ;

