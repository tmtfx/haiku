SubDir HAIKU_TOP src add-ons kernel drivers crypto ;

UsePrivateHeaders kernel drivers crypto ;
UsePrivateKernelHeaders ;

UsePublicHeaders crypto ;
UsePrivateHeaders crypto ;

UseHeaders [ FDirName $(HAIKU_TOP) headers private kernel ] : true ;
UseHeaders [ FDirName $(HAIKU_TOP) headers private kernel util ] : true ;
UsePrivateHeaders [ FDirName $(HAIKU_TOP) headers private kernel arch x86 ] ;

if $(TARGET_ARCH) = x86_64 || $(TARGET_ARCH) = x86 {
    local archFlags = -msha -msse4.1 -msse4.2 -mavx ;
    CCFLAGS += $(archFlags) ;
    CXXFLAGS += $(archFlags) ;
}

KernelAddon crypto :
    CryptoDevice.cpp
    BCryptoDevice.cpp
    crypto_module.cpp
    BCryptoCore.cpp
    BCryptoCPU.cpp
    BCryptoEntropy.cpp
    # Engines
    PadLock.cpp
    PadLockRNG.cpp
    AESNI.cpp
    x86CPUDigest.cpp
    x86CPURNG.cpp
    SoftCrypto.cpp
    soft_aes.cpp
    soft_chacha20.cpp
    SoftDigest.cpp
    soft_sha.cpp
    soft_blake.cpp
;

AddFilesToHaikuImage system add-ons kernel drivers bin : crypto ;
