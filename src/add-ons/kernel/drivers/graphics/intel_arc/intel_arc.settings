# Settings file for the Intel ARC driver and accelerant
#
# This file should be moved to the directory
# ~/config/settings/kernel/drivers/
#

# trident.driver parameters:
#accelerant "intel_arc.accelerant"    # selects accelerant filename to be used // not implemented
dumprom     false                # dump bios rom to ~/trident.rom // not yet implemented

# intel_arc.accelerant parameters:
#memory     8                   # in MB, override builtin memory size detection (es. 4, 6, 8) // not yet implemented
hardcursor  false                 # if true use on-chip hardware cursor # not implemented
cursorbits  32                  # number of bits used to draw bitmap cursor
overlay  false          # if true use hardware accelerated video overlays # not implemented

# EDID override: load the EDID from a file saved with the "Dump EDID" button
# of the Screen preferences instead of reading it from the monitor (DDC),
# the video BIOS or the boot loader. Useful when the card/monitor combination
# cannot provide an EDID. The file must be an edid1_info dumped by Screen,
# not a raw 128 byte EDID block. Remove or comment out to disable.
#edid /boot/home/config/non-packaged/settings/edid/dumped_edid.bin
