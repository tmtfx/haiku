# Settings file for the Trident driver and accelerant
#
# This file should be moved to the directory
# ~/config/settings/kernel/drivers/
#

# trident.driver parameters:
#accelerant "trident.accelerant"    # selects accelerant filename to be used
dumprom     false                # dump bios rom to ~/trident.rom // not yet implemented

# trident.accelerant parameters:
#memory     8                   # in MB, override builtin memory size detection (es. 4, 6, 8)
hardcursor  true                 # if true use on-chip hardware cursor
cursorbits  2                  # number of bits used to draw bitmap cursor

