# Settings file for the Silicon Motion SM750 driver and accelerant
#
# This file should be moved to the directory
# ~/config/settings/kernel/drivers/
#

# sm750.driver parameters:
#accelerant "sm750.accelerant"    # selects accelerant filename to be used
dumprom     false                # dump bios rom to ~/sm750.rom (not implemented)

# sm750.accelerant parameters:
usebios     false                # if true rely on bios to coldstart (not recommended for SM750) (not implemented)
#memory     16                   # in MB, override builtin memory size detection (es. 16, 32, 64)
hardcursor  true                 # if true use on-chip hardware cursor
cursorbits  2                  # number of bits used to draw bitmap cursor
usealphacursor false		# for BitmapCursor use card's alpha layer
#logmask    0x00000000           # nothing logged (default) (not implemented)
#logmask    0xffffffff           # log everything to file (not implemented)

#force_crt true                 # mutually exclusive with force_panel: force crt layer usage (not implemented)
#force_panel true            # force panel layer usage (not implemented)

# SM750 specific tweaks:
dualhead    true                 # enable support for both CRT and Panel (not implemented)
force_pci   true                 # SM750 is native PCI/PCIe, keep true (not implemented)
