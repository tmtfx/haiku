SubDir HAIKU_TOP src add-ons kernel drivers graphics sm750 ;

SubDirCcFlags -DENABLE_LOGGING -DLOG_INCLUDE_STARTUP -DIS_PIRATI_BUILD ;

UsePrivateHeaders graphics ;
UsePrivateSystemHeaders ;
UsePrivateHeaders [ FDirName graphics common ] ;
UsePrivateHeaders [ FDirName graphics vesa ] ;
UsePrivateHeaders [ FDirName graphics sm750 ] ;
UsePrivateKernelHeaders ;

KernelAddon sm750 :
	driver.cpp
	init.c
	decode_edid.c
	:
	libgraphicscommon.a
;

SEARCH on [ FGristFiles
		kernel_cpp.cpp 
	] = [ FDirName $(HAIKU_TOP) src system kernel util ] ;

# edid_decode() for the raw EDID read from the video BIOS (same as the
# boot loader does)
SEARCH on [ FGristFiles decode_edid.c ]
	= [ FDirName $(HAIKU_TOP) src add-ons accelerants common ] ;
