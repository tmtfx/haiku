SubDir HAIKU_TOP src kits crypto ;

# Usa gli header pubblici e privati del tuo nuovo kit

UsePublicHeaders crypto support ;

local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup ] {
	on $(architectureObject) {
		SharedLibrary [ MultiArchDefaultGristFiles libcrypto_api.so ] :
			BCrypto.cpp
			:
			be # Linka la libreria base di Haiku
			;
	}
}
