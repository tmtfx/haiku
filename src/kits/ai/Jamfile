SubDir HAIKU_TOP src kits ai ;

if $(LOVE_IS_IN_THE_AIR) {
    SubDirC++Flags -DLOVE_IS_IN_THE_AIR ;
}

SetSubDirSupportedPlatforms haiku ;
UsePrivateHeaders shared ;

local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup ] {
    on $(architectureObject) {
        local architecture = $(TARGET_PACKAGING_ARCH) ;

        UsePrivateSystemHeaders ;
        UsePublicHeaders ai support ;

        SharedLibrary libai_api.so :
            AIConfig.cpp
            AICommands.cpp
            AIPlugin.cpp
            :
            be
            shared
        ;
        
        #HaikuInstall libai_api.so : /boot/system/lib ;
    }
}
