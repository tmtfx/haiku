resource app_signature "application/x-vnd.Haiku-Fingerprint";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major      = 0,
	middle     = 1,
	minor      = 0,
	variety    = B_APPV_ALPHA,
	internal   = 0,
	short_info = "Fingerprint",
	long_info  = "Fingerprint preferences (c)2026 Haiku, Inc."
};
