SubDir HAIKU_TOP src preferences fingerprint ;

UsePrivateHeaders shared ;
UsePublicHeaders crypto support ;

local cryptoLib = libcrypto_api.so ;
SEARCH on $(cryptoLib) = /boot/system/lib ;

Application Fingerprint :
	FingerprintApp.cpp
	FingerprintWindow.cpp
	FingerprintActivationWindow.cpp
	FingerprintPasswordGateWindow.cpp
	FingerListItem.cpp
	: be localestub shared [ TargetLibstdc++ ] $(cryptoLib)
	: Fingerprint.rdef
;

DoCatalogs Fingerprint :
	x-vnd.Haiku-Fingerprint
	:
	FingerprintApp.cpp
	FingerprintWindow.cpp
	FingerprintActivationWindow.cpp
	FingerprintPasswordGateWindow.cpp
;
