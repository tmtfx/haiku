SubDir HAIKU_TOP src preferences keystore ;

UsePrivateHeaders preferences shared app interface ;
UsePublicHeaders app interface support ;

local cryptoLib = libcrypto_api.so ;
SEARCH on $(cryptoLib) = /boot/system/lib ;

local opensslLibs = libssl.so libcrypto.so ;
SEARCH on $(opensslLibs) = /boot/system/develop/lib ;

UseBuildFeatureHeaders openssl ;
SubDirSysHdrs /boot/system/develop/headers ;

if $(TARGET_PACKAGING_ARCH) = x86_gcc2 {
	# OpenSSL's headers use a GCC attribute syntax that the legacy gcc2
	# compiler does not fully understand, turning into a harmless
	# "attribute directive ignored" warning that -Werror then treats
	# as fatal.
	ObjectC++Flags ResetMasterWindow.cpp : -Wno-error ;
}

Application KeyStore :
    KeyStoreApp.cpp
    KeyStoreWindow.cpp
    ResetMasterWindow.cpp
    : be localestub [ TargetLibstdc++ ] [ TargetLibsupc++ ] shared $(cryptoLib) $(opensslLibs)
;
