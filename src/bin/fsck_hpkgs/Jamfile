SubDir HAIKU_TOP src bin fsck_hpkgs ;

UsePrivateHeaders package storage crypto ;

# Add search path for HPKGIntegrityConstants.h
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src kits package hpkg ] ;

local sources =
	fsck_hpkgs.cpp
	PackageVerifier.cpp
	ConsoleReporter.cpp
	IntegrityQuery.cpp
	;

# Use SimpleTest (no SetType processing) 
SimpleTest fsck_hpkgs :
	$(sources)
	: be shared
	package
	libcrypto_api.so
	[ TargetLibsupc++ ]
	;

# Install to /bin
InstallBin $(HAIKU_APP_BIN_DIR)/fsck_hpkgs ;
