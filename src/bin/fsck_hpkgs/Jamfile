SubDir HAIKU_TOP src bin fsck_hpkgs ;

UsePrivateHeaders app interface shared storage package crypto ;

# Add search path for HPKGIntegrityConstants.h
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src kits package hpkg ] ;

# Recovery strategies are shared with the package daemon (same .cpp
# files compiled into both binaries - see src/servers/package/Jamfile)
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src servers package ] ;

local sources =
	fsck_hpkgs.cpp
	PackageVerifier.cpp
	ConsoleReporter.cpp
	IntegrityQuery.cpp
	RecoveryStrategy.cpp
	RepositoryRecovery.cpp
	ManualRecovery.cpp
	;

# Use SimpleTest (no SetType processing)
# Named fsck.hpkgs (not fsck_hpkgs) to match the standard fsck.<fstype>
# naming convention (fsck.ext2, fsck.fat, ...).
SimpleTest fsck.hpkgs :
	$(sources)
	: be shared
	package
	libcrypto_api.so
	[ TargetLibsupc++ ]
	;

# Install to /bin
InstallBin $(HAIKU_APP_BIN_DIR)/fsck.hpkgs ;
