SubDir HAIKU_TOP src servers fingerprint ;

UsePrivateHeaders shared ;

UseHeaders [ FDirName $(HAIKU_TOP) src servers fingerprint protocol ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers fingerprint protocol uru4000 ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src libs fingerprint nbis include ] : true ;

Application fingerprint_server :
	FingerprintServer.cpp
	FingerprintDatabase.cpp
	EscrowStore.cpp
	NbisMatcher.cpp
	:
	be
	libdevice.so
	localestub
	shared
	libfpprotocol.a
	libfpuru4000.a
	libnbis.a
	[ TargetLibstdc++ ]
	: fingerprint_server.rdef
;

DoCatalogs fingerprint_server :
	x-vnd.Haiku-fingerprint_server
	:
	FingerprintServer.cpp
;

SubInclude HAIKU_TOP src servers fingerprint protocol ;
