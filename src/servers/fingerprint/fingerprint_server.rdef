resource app_signature "application/x-vnd.Haiku-fingerprint_server";

resource app_flags B_EXCLUSIVE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major      = 0,
	middle     = 1,
	minor      = 0,
	variety    = B_APPV_ALPHA,
	internal   = 0,
	short_info = "fingerprint_server",
	long_info  = "fingerprint_server (c)2026 Haiku, Inc."
};
