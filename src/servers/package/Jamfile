SubDir HAIKU_TOP src servers package ;

UsePrivateSystemHeaders ;
UsePrivateHeaders app interface shared storage crypto ;

# Add path to HPKG kit headers for integrity checking
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src kits package hpkg ] ;

Application package_daemon
	:
	CommitTransactionHandler.cpp
	Constants.cpp
	DebugSupport.cpp
	Exception.cpp
	FSTransaction.cpp
	FSUtils.cpp
	HPKGIntegrityWriter.cpp
