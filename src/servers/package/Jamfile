	ManualRecovery.cpp
	Package.cpp
	PackageDaemon.cpp
	PackageFile.cpp
	PackageFileManager.cpp
	PackageManager.cpp
	ProblemWindow.cpp
	RecoveryStrategy.cpp
	RepositoryRecovery.cpp
	ResultWindow.cpp
	Root.cpp
	Volume.cpp
	VolumeState.cpp
	:
	be localestub package
	libcrypto_api.so
	[ TargetLibstdc++ ]
	:
	package_daemon.rdef
;

DoCatalogs package_daemon :
	x-vnd.haiku-package_daemon
	:
	PackageManager.cpp
	ProblemWindow.cpp
	ResultWindow.cpp
;
