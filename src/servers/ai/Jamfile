SubDir HAIKU_TOP src servers ai ;

UseHeaders [ FDirName $(HAIKU_TOP) src kits ai ] : true ;
UsePublicHeaders ai ;

AddResources ai_server : ai_server.rdef ;

Application ai_server : 
    ai_server.cpp
    mcp_manager.cpp
    :
    localestub
;

if $(LOVE_IS_IN_THE_AIR) {
    SubDirC++Flags -DLOVE_IS_IN_THE_AIR ;
    UsePrivateHeaders network netservices shared ;
    LinkAgainst ai_server : be [ TargetLibstdc++ ] libai_api.so libbnetapi.so libnetservices.a <$(TARGET_PACKAGING_ARCH)>libshared.a $(TARGET_NETWORK_LIBS) ;
} else {
    LinkAgainst ai_server : be [ TargetLibstdc++ ] libai_api.so ;
}

