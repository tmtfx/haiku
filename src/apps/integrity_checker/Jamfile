SubDir HAIKU_TOP src apps integrity_checker ;

UsePrivateSystemHeaders ;
UsePrivateHeaders app interface shared storage crypto ;

# Add path to recovery strategy sources/headers
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src servers package ] ;

# Add path to PackageVerifier (real scanning) and its headers - the
# implementations of the HPKGIntegrityConstants.h helpers it calls come
# from libpackage.so (linked below), same as fsck_hpkgs.
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src bin fsck_hpkgs ] ;
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src kits package hpkg ] ;

Application IntegrityChecker
	:
	IntegrityCheckerApp.cpp
	IntegrityCheckerWindow.cpp
	ResultsListView.cpp
	QueryBuilderView.cpp
	SettingsView.cpp
	ScanThread.cpp
	RepairThread.cpp
	PackageVerifier.cpp
	RecoveryStrategy.cpp
	RepositoryRecovery.cpp
	ManualRecovery.cpp
	:
	be localestub package
	libcrypto_api.so
	[ TargetLibstdc++ ]
;
